.page {
  min-height: 100vh;
  padding: 14px;
  box-sizing: border-box;
}

.status-card {
  margin-bottom: 12px;
}

.status-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.status-dot.online {
  background: #16a34a;
}

.status-dot.offline {
  background: #9ca3af;
}

.status-text {
  font-size: 20px;
  font-weight: 700;
}

.line {
  color: #4b5563;
  margin-top: 4px;
}

.section-title {
  font-weight: 700;
  margin-bottom: 8px;
}

.empty {
  color: #6b7280;
}

.sos-item {
  border-top: 1px solid #eef0f3;
  padding: 8px 0;
  font-size: 14px;
  color: #374151;
}

.refresh-btn {
  background: #2563eb;
  color: #fff;
  border-radius: 10px;
}

.unbind-btn {
  margin-top: 10px;
  background: #fff;
  color: #b42318;
  border: 1px solid #fda29b;
  border-radius: 10px;
}

