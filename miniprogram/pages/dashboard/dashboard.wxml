<view class="page">
  <view class="card status-card">
    <view class="status-row">
      <view class="status-dot {{statusClass}}"></view>
      <view class="status-text">{{statusLabel}}</view>
    </view>
    <view class="line">老人：{{elderName}}</view>
    <view class="line">最近报平安：{{lastCheckinText}}</view>
  </view>

  <view class="card">
    <view class="section-title">SOS 历史</view>
    <block wx:if="{{sosList.length === 0}}">
      <view class="empty">暂无 SOS 记录</view>
    </block>
    <block wx:for="{{sosList}}" wx:key="id">
      <view class="sos-item">
        <view>时间：{{item.created_at_text}}</view>
        <view>地址：{{item.address_text}}</view>
      </view>
    </block>
  </view>

  <button class="refresh-btn" loading="{{loading}}" bindtap="fetchDashboard">刷新状态</button>
  <button class="unbind-btn" bindtap="onUnbind">一键解绑</button>
</view>

